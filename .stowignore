# Compatibility ignore list for this repo.
# Canonical Stow behavior is controlled by .stow-local-ignore.
# Keep this file in sync so tooling/users expecting .stowignore still see intent.

# Repo metadata and tooling
.git
.github
.githooks
.codex
.zencoder
.gitignore
.gitattributes
.stowignore
.stow-global-ignore
.stow-local-ignore

# Generated/runtime/backup content (not for $HOME symlinking)
.firewall_cache
firewall_backups
infra-backup
non_stow
scripts

# Helper files and docs (repo-only)
README.md
SECURITY.md
LICENSE
backup-dotfiles.sh
restore-dotfiles.sh
restore_packages.sh
infra-backup.sh
dnf-packages.txt
gnome-settings.dconf

# Assets not intended as dotfile symlinks
wallpapers
