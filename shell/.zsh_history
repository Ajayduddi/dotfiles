: 1753627198:0;cd /home/ajay/.dotfiles && cat > test_package_separation.sh << 'EOF'\
#!/bin/bash\
# Test script to demonstrate package separation\
DOTFILES_DIR="/home/ajay/.dotfiles"\
temp_all="$DOTFILES_DIR/test_packages_demo.txt"\
# Define common cross-platform packages (universal)\
common_packages=(\
    "curl" "wget" "git" "vim" "nano" "htop" "tree" "zip" "unzip" \
    "tar" "gzip" "rsync" "ssh" "bash" "zsh" "tmux" "screen"\
    "python3" "nodejs" "npm" "docker" "docker-compose"\
    "firefox" "chromium" "vlc" "gimp" "libreoffice"\
    "neofetch" "btop" "ranger" "fzf" "ripgrep" "fd"\
    "exa" "bat" "jq" "ncdu" "rclone" "gh" "code"\
)\
# Create universal packages file\
universal_temp="/tmp/test_universal_$$.txt"\
for pkg in "${common_packages[@]}"; do\
    if grep -q "^${pkg}$" "$temp_all"; then\
        echo "$pkg" >> "$universal_temp"\
    fi\
done\
# Create OS-specific file with remaining packages\
os_temp="/tmp/test_os_$$.txt"\
comm -23 <(sort "$temp_all") <(sort "$universal_temp") > "$os_temp"\
echo "=== UNIVERSAL PACKAGES (packages.txt) ==="\
cat "$universal_temp"\
echo "=== OS-SPECIFIC PACKAGES (dnf-packages.txt) ==="\
cat "$os_temp"\
echo\
echo "Universal count: $(wc -l < "$universal_temp")"\
echo "OS-specific count: $(wc -l < "$os_temp")"\
# Cleanup\
rm -f "$universal_temp" "$os_temp"\
EOF
