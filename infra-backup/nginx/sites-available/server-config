server {
    listen 80;
    server_name api.ajayduddi.site;     
    return 301 https://$host$request_uri;
}

server {

    listen 443 ssl;
    server_name api.ajayduddi.site;

    ssl_certificate     /etc/ssl/certs/cloudflare-origin.crt;
    ssl_certificate_key /etc/ssl/private/cloudflare-origin.key;

    ssl_client_certificate /etc/ssl/certs/origin-pull-ca.pem;
    ssl_verify_client on;

    location / {
        proxy_pass http://localhost:4000;  # Express API port
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
	proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_cache_bypass $http_upgrade;
	# VERY IMPORTANT FOR COOKIES / AUTH
	proxy_set_header Authorization $http_authorization;
	proxy_pass_request_headers on;
    }

    access_log /var/log/nginx/api.ajayduddi.site.access.log;
    error_log /var/log/nginx/api.ajayduddi.site.error.log;
}

server {
    listen 80;
    server_name app.ajayduddi.site;
    return 301 https://$host$request_uri;
}

server{
   
    listen 443 ssl;
    server_name app.ajayduddi.site;

