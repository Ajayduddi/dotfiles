# Canonical GNU Stow ignore file for this repo/package.
# These patterns are Perl-compatible regex and are matched against paths
# inside the package when stowing from repo root.

# Repo metadata and tooling
^\.git$
^\.github$
^\.githooks$
^\.codex$
^\.zencoder$
^\.gitignore$
^\.gitattributes$
^\.stowignore$
^\.stow-global-ignore$
^\.stow-local-ignore$

# Generated/runtime/backup content (not for $HOME symlinking)
^\.firewall_cache$
^firewall_backups$
^infra-backup$
^non_stow$
^scripts$

# Helper files and docs (repo-only)
^README\.md$
^SECURITY\.md$
^LICENSE$
^LICENSE\.md$
^backup-dotfiles\.sh$
^restore-dotfiles\.sh$
^restore_packages\.sh$
^infra-backup\.sh$
^dnf-packages\.txt$
^gnome-settings\.dconf$

# Assets not intended as dotfile symlinks
^wallpapers$
