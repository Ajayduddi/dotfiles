<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>eu.maveniverse.maven.shared</groupId>
  <artifactId>core</artifactId>
  <version>0.1.6</version>
  <name>eu.maveniverse.maven.shared:core</name>
  <description>Maveniverse Maven Shared.</description>
  <url>https://www.maveniverse.eu/shared/core</url>
  <inceptionYear>2023</inceptionYear>
  <organization>
    <name>Maveniverse Team</name>
    <url>https://maveniverse.eu</url>
  </organization>
  <licenses>
    <license>
      <name>EPL-2.0</name>
      <url>https://www.eclipse.org/legal/epl-2.0/</url>
    </license>
  </licenses>
  <developers>
    <developer>
      <name>Maveniverse Team</name>
      <organization>Maveniverse Team</organization>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:git@github.com:maveniverse/maven-shared.git/core</connection>
    <developerConnection>scm:git:git@github.com:maveniverse/maven-shared.git/core</developerConnection>
    <tag>release-0.1.6</tag>
    <url>https://github.com/maveniverse/maven-shared/core</url>
  </scm>
  <ciManagement>
    <system>Github</system>
    <url>https://github.com/maveniverse/maven-shared/actions</url>
  </ciManagement>
  <distributionManagement>
    <repository>
      <id>sonatype-central-portal</id>
      <name>Sonatype Central Portal</name>
      <url>https://repo.maven.apache.org/maven2/</url>
    </repository>
    <snapshotRepository>
      <id>sonatype-central-portal</id>
      <name>Sonatype Central Portal</name>
      <url>https://central.sonatype.com/repository/maven-snapshots/</url>
    </snapshotRepository>
    <site>
      <id>github</id>
      <url>scm:git:git@github.com:maveniverse/maven-shared.git/core/shared/core</url>
    </site>
  </distributionManagement>
  <dependencies>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>1.7.36</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <version>5.12.2</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>1.7.36</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>