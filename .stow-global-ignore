# Global ignore patterns for GNU Stow. These patterns are matched against
# items when Stow scans the repository. Useful to ensure consistent behavior
# even if .stowignore is not picked by some stow versions.

# Git and tooling metadata
^.git$
^\.github$
^\.zencoder$
^\.stowignore$
^\.stow-global-ignore$
^\.gitignore$
^\.gitattributes$

# Backups / non-stow content
^non_stow$
^scripts
^infra-backup

# Dev environment backups (ensure never stowed)
^non_stow/dev

# Assets not destined for $HOME
^wallpapers$

# Repo helper scripts and misc files
^backup-dotfiles\.sh$
^restore-dotfiles\.sh$
^infra-backup\.sh$
^README\.md$
^restore_packages\.sh$
^dnf-packages\.txt$
^gnome-settings\.dconf$